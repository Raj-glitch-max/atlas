      "description": "Verification with presenter binding enabled and presenter matching delegate",
      "policy": {
        "R": "2s",
        "skewTolerance": "30s",
        "requirePresenter": true
      },
      "record": {
        "principal": "spiffe://example.org/principal",
        "delegate": "spiffe://example.org/workload-a",
        "scope": ["read:data"],
        "issuedAt": "2024-01-01T00:00:00Z",
        "expiration": "2025-01-01T00:00:00Z",
        "issuerKeyId": "authority-key-1"
      },
      "presenter": "spiffe://example.org/workload-a",
      "expect": "Accept",
      "causes": [],
      "trace": {
        "checks": [
          {"name": "identity_binding", "outcome": "Pass"},
          {"name": "integrity", "outcome": "Pass"},
          {"name": "expiry", "outcome": "Pass"},
          {"name": "scope_integrity", "outcome": "Pass"},
          {"name": "revocation_status", "outcome": "Pass"},
          {"name": "presenter_binding", "outcome": "Pass"}
        ]
      }
    },
